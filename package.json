{
  "name": "kraland-css",
  "version": "1.0.0",
  "type": "module",
  "description": "Kraland Red Theme",
  "scripts": {
    "build": "node build.js",
    "build:dev": "node build.js --dev",
    "validate": "node validate.js",
    "postbuild": "npm run validate",
    "watch": "nodemon --watch kraland-theme.css --watch kraland-userscript-template.js --exec \"npm run build\"",
    "serve": "http-server -p 4848 --cors -c-1",
    "test:e2e": "npx playwright test --project=chromium",
    "test:all": "node tests/e2e/run.mjs all",
    "test:zone": "node tests/e2e/run.mjs zone",
    "test:changed": "node tests/e2e/run.mjs changed",
    "test:red": "node tests/e2e/run.mjs red",
    "test:zones": "node tests/e2e/run.mjs list",
    "test:router": "node tests/e2e/lib/router.test.mjs",
    "test:transitions": "node tests/e2e/breakpoint-switch.mjs",
    "test:map-exclusions": "node tests/e2e/map-exclusions.mjs",
    "test:qualite-usage": "node tests/e2e/plateau-qualite-usage.mjs",
    "test:profil-mobile": "node tests/e2e/plateau-profil-mobile.mjs",
    "test:demarrage": "node tests/e2e/demarrage-mobile.mjs",
    "test:forum-mobile": "node tests/e2e/forum-mobile.mjs",
    "test:croix": "node tests/e2e/croix-directionnelle.mjs",
    "test:messages": "node tests/e2e/messages-v3.mjs",
    "test:image-fallback": "node tests/e2e/image-fallback.mjs",
    "audit:map-images": "node tests/e2e/audit-map-images.mjs --online",
    "lint:css": "stylelint \"**/*.css\"",
    "lint:css:fix": "stylelint \"**/*.css\" --fix",
    "lint:js": "eslint .",
    "lint:js:fix": "eslint . --fix",
    "lint": "npm run lint:css && npm run lint:js",
    "lint:fix": "npm run lint:css:fix && npm run lint:js:fix"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "eslint": "^9.39.2",
    "http-server": "^14.1.1",
    "lightningcss": "^1.31.1",
    "nodemon": "^3.0.1",
    "playwright": "^1.51.0",
    "stylelint": "^16.26.1",
    "stylelint-config-standard": "^39.0.1",
    "terser": "^5.44.1",
    "userscript-meta": "^1.0.1"
  }
}
